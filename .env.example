# Example env file — SAFE to commit (no real secrets)
# Copy to .env.dev / .env.staging / .env.production and fill in real values.
# The real files are git-ignored.

DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
NODE_ENV=development
PORT=5000

# Feature flags — set to 'true' and provide real key to enable
EMAIL_ENABLED=false
EMAIL_PASSWORD=
FROM_EMAIL=

MYFATOORAH_ENABLED=false
MYFATOORAH_API_KEY=

TAQNYAT_ENABLED=false
TAQNYAT_API_KEY=

PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
